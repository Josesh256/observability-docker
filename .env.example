# Copy this file to '.env' and fill in your values
PROJECT_NAME=observability-stack

# Service Port Configuration
NGINX_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
WIREGUARD_PORT=51820

# Grafana Credentials
GF_SECURITY_ADMIN_PASSWORD=admin

# WireGuard VPN Configuration
# WG_SERVERURL should be your PC's local IP (for LAN testing) or public IP (for VPS deployment)
WG_SERVERURL=192.168.69.73
WG_PEERS=laptop,phone
WG_PEER_DNS=1.1.1.1
WG_INTERNAL_SUBNET=10.13.13.0/24
WG_UI_PORT=51821

# Hashed password for WG-Easy panel (use bcrypt to hash your desired password)
# Default below is the bcrypt hash of "admin"
WG_UI_PASSWORD_HASH=$$2a$$10$$TkNhMEL/lQnJmR40LQfIk.UirrX739jLwsZWAb6Uy3ml6sddtA1MG

# Telegram Alerting Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
